[Unit]
# The privileged half of machine-level hosting: it reads the DRM/KMS scanout to
# capture and hardware-encode the screen, and injects input through uinput. It
# faces no network at all -- the unprivileged machine service does that and
# drives this one over a Unix socket.
Description=OpenStream privileged device broker
Documentation=file:///usr/share/doc/openstream/BUILD.md
After=systemd-logind.service
Wants=systemd-logind.service

[Service]
Type=simple
ExecStart=/usr/bin/openstream-host-broker
Restart=on-failure
RestartSec=2

# Configuration lives in a root-owned file, not in this unit.
#
# Two reasons. A package upgrade replaces the unit, so anything an operator
# edited here is lost at the worst possible moment -- the machine stops hosting
# and the reason is a file that reverted. And the values that have to be set are
# a numeric uid and gid, which only the install knows: writing them here would
# mean shipping a unit that is wrong on every machine.
#
# `-` so a missing file is not a startup failure: the unit ships before postinst
# has written anything, and an unconfigured broker is meant to start and refuse
# sessions rather than fail to start.
EnvironmentFile=-/etc/openstream/broker.env

# Nothing is set here. An `Environment=NAME=` is not an unset variable -- the
# process sees it set to the empty string, and every one of these is read as a
# value: an empty uid or gid fails to parse and the broker exits, an empty
# grant-key path is a file that cannot be opened. Unset has to mean unset, so
# the defaults in the program are what apply until broker.env says otherwise.

# Creates and owns /run/openstream, where the socket lives. systemd removes it
# when the service stops, so a stale socket cannot outlive the broker that was
# listening on it.
#
# The group is what makes it reachable: the directory is root-owned 0750, and
# without a group the unprivileged machine service cannot traverse it to find
# the socket, whatever the socket's own mode says.
RuntimeDirectory=openstream
RuntimeDirectoryMode=0750
RuntimeDirectoryGroup=openstream

# Hardening. This process is root and holds the two privileges that genuinely
# need elevation, so everything it does not need is taken away.
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
SystemCallFilter=@system-service

# CapabilityBoundingSet is deliberately NOT narrowed here.
#
# The obvious set is CAP_SYS_ADMIN plus CAP_DAC_OVERRIDE, and it may well be
# right -- but DRM master operations and uinput device creation are exactly the
# kind of thing that needs one more capability than expected, and the symptom of
# guessing wrong is a service that fails to start on a machine nobody in this
# project can currently test on. Shipping a restriction that has never been run
# is worse than shipping none: it turns a working install into a broken one and
# the reason is invisible.
#
# Narrow it once someone has a Linux host to boot: start from
# `CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_OVERRIDE`, confirm capture and
# injection still work, and record the run.

# PrivateNetwork is deliberate and load-bearing: the whole design is that the
# privileged half cannot be reached over the network. If it ever needs a socket
# to the outside, that is a design change, not a unit-file tweak.

# It must read the grant key, and the GPU and uinput nodes it exists to use.
ReadOnlyPaths=/etc/openstream
DeviceAllow=/dev/uinput rw
DeviceAllow=char-drm rw
PrivateDevices=false

[Install]
WantedBy=multi-user.target
