[Unit]
# The network-facing half of machine-level hosting: signalling, ICE, the peer
# connection and the session approval. It holds none of the privileges that need
# elevation -- for capture and input it asks the broker over a Unix socket, so
# the process an attacker can reach from the network never runs as root.
Description=OpenStream machine service
Documentation=file:///usr/share/doc/openstream/BUILD.md
After=network-online.target openstream-host-broker.service
Wants=network-online.target
# Requires, not Wants: without the broker there is nothing to capture, and a
# machine service that starts anyway would sit answering the network with an
# offer it cannot fulfil.
Requires=openstream-host-broker.service

[Service]
Type=simple
ExecStart=/usr/bin/openstream-machine-service
Restart=on-failure
RestartSec=5

# Unprivileged, and its own user so the broker's SO_PEERCRED check has something
# specific to admit. systemd creates it; it owns nothing but its runtime
# directory.
User=openstream
Group=openstream
DynamicUser=false

Environment=OPENSTREAM_SIGNAL_ORIGIN=
Environment=OPENSTREAM_BROKER_SOCKET=/run/openstream/broker.sock
# The pairing the agent writes, carrying the control plane's signed approval for
# the session. This service cannot produce one or verify one; it relays it to
# the broker unread, which is what makes the broker's check worth anything.
Environment=OPENSTREAM_PAIRING_FILE=

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
