# OS/editor noise
.DS_Store
.idea/
.vscode/
.commandcode/
.worktrees/

# Local agent planning/review artifacts; versioned plans live under docs/.
.superpowers/sdd/

# Rust/Cargo build output
**/target/
**/*.rs.bk

# Android/Gradle build output
mobile/**/build/
mobile/**/.gradle/
mobile/**/local.properties

# Local secrets and pairing material
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
pairing.json
openstream-*.env

# Generated media and diagnostics
*.h264
*.h265
*.ivf
*.pcm
*.wav
*.pcap
*.pcapng
*.log
# Exception: small committed H.264 test fixtures the Windows decoder tests read
# via include_bytes! (the CI runner has no ffmpeg to generate them).
!engine/lowlat/crates/desktop-client/src/fixtures/*.h264

# Authorized local reverse-engineering evidence. These files are not part of
# the public source tree and must never be committed or redistributed.
analysis/
extracted_pkg/
Parsec.app/
Parsec_*.xapk
parsec-*.pkg
parsec-*.exe

# Optional local reference checkout; OpenStream does not build from it.
libmatoya/

# The nested lowlat checkout used to have its own submodule metadata. The
# public repository includes the source snapshot, not nested Git metadata.
engine/lowlat/.gitmodules

# Local session handoffs and audit bundles are working notes, not source.
handoff.md
openstream-1.0-review-*/

# Staged release output. Everything under it is generated by
# scripts/build-release-artifacts.sh and scripts/generate-sbom.sh from sources
# already in this tree, so committing it would duplicate the inputs and let a
# stale SBOM or checksum outlive the lockfiles it was derived from. Anchored
# to the repository root so the desktop shell's own `dist/` rule stays local
# to that package.
/dist/
