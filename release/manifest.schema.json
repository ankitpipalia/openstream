{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openstream.example/schema/release-manifest-1.json",
  "title": "OpenStream 1.0 release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "release_version", "artifacts", "evidence", "gates"],
  "properties": {
    "manifest_version": { "const": 1 },
    "release_version": { "const": "1.0.0" },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "platform", "path", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "platform": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\./).+" },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checksums", "sbom", "signing"],
      "properties": {
        "checksums": { "type": "string", "minLength": 1 },
        "sbom": { "type": "string", "minLength": 1 },
        "signing": { "type": "string", "minLength": 1 }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "observed_at", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "result": { "const": "PASS" },
          "observed_at": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
